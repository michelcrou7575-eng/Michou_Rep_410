FUNCTION_BLOCK "PANEL LED TIMERS"
TITLE =Panel LED clocks for FC158 "SCALE PANEL LAMPS" FB556
// v0.1 - NEW, same multi-instance "TON" wrapper pattern as FB555
//   IEC_TIMERS (Michou's own design - one FB, one instance DB, called
//   once per scan, every timer's IN recomputed fresh every scan - see
//   that file's header for why SFB/TON-family timers need this). Three
//   free-running clocks for FC157:
//   - SCAN: paces the white-lamp scan step (500ms, same rate FC155's old
//     lamp-scan network used).
//   - PANIC: paces "Panic Mode"'s all-3-together strobe (150ms - faster
//     than SCAN, deliberately "urgent"/eye-catching per Michou's "Any
//     ways to impress").
//   - ALARM: paces GRN/RED blink (500ms) - shared by both colors, so if
//     ever both blink at once they blink in sync; flagged as my own
//     choice, not asked for explicitly.
//   Self-oscillating: caller computes each IN as "command AND NOT this
//   FB's own OUT" (see FC157's "Timers" network) - once PT elapses, OUT=1
//   for one scan, which makes IN false next scan, resetting OUT/ET to 0,
//   which makes IN true again the scan after - repeating at 2x PT period
//   while the command bit stays true.
//
// v0.2 - reconciled against Michou's own live edits (2026-10-06): he
//   renumbered the FC this feeds from FC157 to FC158 (FC157 wasn't
//   actually free on the live project - confirms the caution flagged
//   since v0.1) and renamed it "PANEL LED DRIVE" -> "SCALE PANEL LAMPS".
//   Also renamed THIS block's own symbol to match his space-not-
//   underscore convention for every other named block: "PANEL_LED_
//   TIMERS" -> "PANEL LED TIMERS" (and the instance DB to "PANEL LED
//   TIMERS DB" - see that file's own changelog). Rename only, no logic
//   change.
//
// v0.3 - per Michou (2026-10-06): "DB106 Db108 not needed! FB555
//   Instance is DB555, FB556 Instance is DB556!!!" This FB's instance DB
//   is renumbered DB108 -> DB556 (matching this FB's own number, his
//   preferred convention) - see DB556_PANEL_LED_TIMERS_DB.awl's own
//   changelog. No change to this file itself.
//
// v0.4 - per Michou (2026-10-06): "the RED Lamp is pulsing when Fault!
//   Need Blinking!" The self-oscillating ALARM pattern only holds Q true
//   for ONE scan every PT (~2% duty cycle) - fine for a clock pulse
//   driving a step counter (SCAN/PANIC's own use), wrong for directly
//   driving a lamp someone needs to see blink. FC158 now reads "M 6.5"
//   (a clock-memory bit) directly for GRN/RED blink instead, and no
//   longer calls ALARM_IN/ALARM_IN_TIME. TON_ALARM/ALARM_OUT are DEAD as
//   of this version - left declared (not deleted, in case something
//   else starts depending on them) but nothing feeds or reads them.
VERSION : 0.4


VAR_INPUT
  SCAN_IN : BOOL ;
  SCAN_IN_TIME : TIME ;
  PANIC_IN : BOOL ;
  PANIC_IN_TIME : TIME ;
  ALARM_IN : BOOL ;
  ALARM_IN_TIME : TIME ;
END_VAR
VAR_OUTPUT
  SCAN_OUT : BOOL ;
  PANIC_OUT : BOOL ;
  ALARM_OUT : BOOL ;
END_VAR
VAR
  TON_SCAN : "TON";
  TON_PANIC : "TON";
  TON_ALARM : "TON";
END_VAR
BEGIN
NETWORK
TITLE =Clocks

      CALL #TON_SCAN (
           IN                       := #SCAN_IN,
           PT                       := #SCAN_IN_TIME,
           Q                        := #SCAN_OUT);

      CALL #TON_PANIC (
           IN                       := #PANIC_IN,
           PT                       := #PANIC_IN_TIME,
           Q                        := #PANIC_OUT);

      CALL #TON_ALARM (
           IN                       := #ALARM_IN,
           PT                       := #ALARM_IN_TIME,
           Q                        := #ALARM_OUT);

END_FUNCTION_BLOCK
