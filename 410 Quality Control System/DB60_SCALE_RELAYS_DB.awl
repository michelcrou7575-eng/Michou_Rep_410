DATA_BLOCK "SCALE RELAYS DB"    DB60
TITLE =KWS CY300 Power/Calibration Relay Outputs
// v0.1 - NEW, per Michou's hand-drawn wiring diagram (2026-10-01) showing
//   the KWS CY300's defect workaround: the scale resets its zero/
//   calibration reference every power-up, so two relays were added:
//   - K2 "Power Sw relay" bridges the scale's remote ON/OFF terminal to
//     its Com terminal - toggling K2 remotely power-cycles the scale.
//     Coil on PLC terminal 39, this DB's DBX7.7.
//   - K1 "Calibration Relay" switches the load-cell S+/S- signal pair
//     through a shunt-cal loop built into the scale - energizing K1
//     applies the calibration reference. Coil on PLC terminal 40, this
//     DB's DBX7.6. Both coils share a 24V common per the diagram.
//   Only these two bits are confirmed (Michou gave the exact DB60.DBX7.6/
//   DBX7.7 addresses directly) - bytes 0-6 are NOT from a real online
//   export of this DB, just reserved padding so DBX7.6/7.7 land at the
//   right byte offset. If DB60 already exists on the live PLC with other
//   fields in use, replace Reserved_Byte0-6 with a real capture before
//   downloading this source - do not trust the reserved names/comments
//   below as anything other than placeholders.
//   Also adds Recal_Request/Recal_ReqMem/Recal_Step - sequencing state
//   for the new FC156 "Power-up Calibration Process" (Michou's exact
//   spec, 2026-10-01): K1 on, then K2 pulsed 1s, then 5s wait, then K1
//   off. See FC156 for the step logic.
VERSION : 0.1

  STRUCT
   Reserved_Byte0 : BYTE ;	//Unknown - not from a real online export, see header
   Reserved_Byte1 : BYTE ;	//Unknown - not from a real online export, see header
   Reserved_Byte2 : BYTE ;	//Unknown - not from a real online export, see header
   Reserved_Byte3 : BYTE ;	//Unknown - not from a real online export, see header
   Reserved_Byte4 : BYTE ;	//Unknown - not from a real online export, see header
   Reserved_Byte5 : BYTE ;	//Unknown - not from a real online export, see header
   Reserved_Byte6 : BYTE ;	//Unknown - not from a real online export, see header
   Spare_Bool_70 : BOOL ;	//DBX7.0 - spare
   Spare_Bool_71 : BOOL ;	//DBX7.1 - spare
   Spare_Bool_72 : BOOL ;	//DBX7.2 - spare
   Spare_Bool_73 : BOOL ;	//DBX7.3 - spare
   Spare_Bool_74 : BOOL ;	//DBX7.4 - spare
   Spare_Bool_75 : BOOL ;	//DBX7.5 - spare
   Calibration_Relay_K1 : BOOL ;	//DBX7.6 - K1 coil, PLC terminal 40 - applies the scale's shunt-cal loop, see FC156
   PowerSw_Relay_K2 : BOOL ;	//DBX7.7 - K2 coil, PLC terminal 39 - bridges scale ON/OFF to Com, remote power pulse, see FC156
   Recal_Request : BOOL ;	//Input: HMI/manual, pulse or hold TRUE to start the FC156 power-up calibration sequence
   Recal_ReqMem : BOOL ;	//Internal: edge memory for Recal_Request, see FC156
   Recal_Step : INT ;	//Internal/status: FC156 sequence step - 0 idle, 1 K1 on, 2 K2 1s pulse, 3 5s wait, 4 K1 off/done
  END_STRUCT ;
BEGIN
   Reserved_Byte0 := B#16#0;
   Reserved_Byte1 := B#16#0;
   Reserved_Byte2 := B#16#0;
   Reserved_Byte3 := B#16#0;
   Reserved_Byte4 := B#16#0;
   Reserved_Byte5 := B#16#0;
   Reserved_Byte6 := B#16#0;
   Spare_Bool_70 := FALSE;
   Spare_Bool_71 := FALSE;
   Spare_Bool_72 := FALSE;
   Spare_Bool_73 := FALSE;
   Spare_Bool_74 := FALSE;
   Spare_Bool_75 := FALSE;
   Calibration_Relay_K1 := FALSE;
   PowerSw_Relay_K2 := FALSE;
   Recal_Request := FALSE;
   Recal_ReqMem := FALSE;
   Recal_Step := 0;
END_DATA_BLOCK
