FUNCTION "SCALE POWER-UP CALIBRATION" : VOID
TITLE =KWS CY300 power-up calibration / power-off sequences (K1 cal relay / K2 power relay) FC156
// v0.1 - NEW, per Michou's hand-drawn relay wiring (2026-10-01) and
//   exact sequence (2026-10-01): "1st Calib Relay K1 ... then Power up:
//   K2 ON 1 sec ... Wait 5sec then K1 Off!" - works around the KWS
//   CY300 resetting its zero/calibration reference on every power-up:
//   closing the calibration shunt (K1) BEFORE power-cycling the scale
//   (K2) means the scale sees the known shunt reference the moment it
//   boots.
//
// v0.2 changes vs v0.1 - corrected timing and added power-off, per
//   Michou (2026-10-02): K2 is a momentary button-press simulation - a
//   SHORT pulse (0.5s) powers the scale ON, a LONG pulse (3s) powers it
//   OFF. K1 stays on for a flat 5s on every power-up, with the 0.5s K2
//   pulse happening inside that window. NEW power-off sequence
//   (PowerOff_Step) - just a 3s K2 pulse, no K1.
//
// v0.3 changes vs v0.2 - re-targeted onto the REAL output DB, per
//   Michou's own online rebuild (uploaded as root-level "FC155",
//   2026-10-02 - built directly in FC155, not a separate FC like this
//   one, but its symbol choices are the current truth for what's
//   actually compiled):
//   - DB60 is NOT a standalone "SCALE RELAYS DB" as v0.1/v0.2 assumed -
//     it's "OUTPUTS DB", the same shared output DB FC155 already
//     references for GRN_LED/RED_LED/WHT_SWL_1/2/3. K1/K2 are two
//     previously-unused output bits there (DBX7.6/DBX7.7, exactly where
//     Michou said), now named "OUTPUTS DB".KILOTECK_Calib_K1/
//     KILOTECK_Power_K2 - matching his own online renaming exactly, see
//     DB60_OUTPUTS_DB.awl.
//   - Sequencing state moved from the fictional DB60 into DB105 ("GLUE
//     SCALE CONTROL DB") instead - it's this subsystem's own internal
//     state, not a shared-output concern, and matches where Michou put
//     his own ReCalib_Step. Field names also matched to his choices:
//     ReCalib_Step/Scale_ReCalib_Req (power-on+calibrate) - this repo's
//     own addition, ReCalib_ReqMem (edge memory, not in his upload) and
//     PowerOff_Step/Scale_PowerOff_Req/PowerOff_ReqMem (power-off, not
//     in his upload yet - built fresh per his text spec) follow the
//     same naming pattern.
//   - Kept as a SEPARATE FC per Michou's explicit request ("So i need a
//     'Power up Calibration Process FC'!", 2026-10-02) rather than
//     folding into FC155 the way his own upload did - that upload likely
//     predates this request (same "operator edits online first,
//     describes the ask after" pattern as elsewhere in this project).
//
//   Power-on + calibrate sequence (DB105.ReCalib_Step):
//     0 idle - waiting for a Scale_ReCalib_Req rising edge (ignored if
//       PowerOff_Step is mid-sequence)
//     1 KILOTECK_Calib_K1 energized, T53 (5s K1-hold) started, advances
//       immediately
//     2 KILOTECK_Power_K2 pulsed on for 0.5s (T52), then released
//     3 waiting for T53 (started back in step 1) to elapse - T52's
//       0.5s pulse happens entirely inside this window
//     4 (reached via T53 elapsing) KILOTECK_Calib_K1 released, sequence
//       done, ReCalib_Step -> 0
//
//   Power-off sequence (DB105.PowerOff_Step):
//     0 idle - waiting for a Scale_PowerOff_Req rising edge (ignored if
//       ReCalib_Step is mid-sequence)
//     1 KILOTECK_Power_K2 pulsed on for 3s (T54), then released,
//       PowerOff_Step -> 0
//
//   Timings (0.5s/3s K2 pulses, 5s K1 hold) are exactly what Michou
//   specified, not placeholders. T52/T53/T54 confirmed unused elsewhere
//   in the 410 project (same check already applied to T50/T51 in
//   FC155).
//
//   NOT yet done: nothing calls this FC yet - needs a CALL "SCALE
//   POWER-UP CALIBRATION" added to OB1 (not tracked in this repo) same
//   as FC155 presumably already has. Scale_ReCalib_Req/
//   Scale_PowerOff_Req aren't wired to HMI buttons yet either - same
//   open gap as DB105.Reset_Alarms.
VERSION : 0.3

BEGIN
NETWORK
TITLE =Power-on + calibrate sequence - K1 on for a flat 5s, K2 pulsed 0.5s inside that window

      A     "GLUE SCALE CONTROL DB".Scale_ReCalib_Req;
      FP    "GLUE SCALE CONTROL DB".ReCalib_ReqMem;
      JCN   RC_STP;

      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     0;
      <>I   ;
      JC    RC_STP;
      L     "GLUE SCALE CONTROL DB".PowerOff_Step;
      L     0;
      <>I   ;
      JC    RC_STP;

      L     1;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;

RC_STP: L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     1;
      ==I   ;
      JC    RC_S1;
      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     2;
      ==I   ;
      JC    RC_S2;
      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     3;
      ==I   ;
      JC    RC_S3;
      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     4;
      ==I   ;
      JC    RC_S4;
      JU    RC_DN;

RC_S1: S     "OUTPUTS DB".KILOTECK_Calib_K1;
      L     S5T#5S;
      SD    T     53;
      L     2;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;
      JU    RC_DN;

RC_S2: S     "OUTPUTS DB".KILOTECK_Power_K2;
      L     S5T#500MS;
      SD    T     52;
      A     T     52;
      JCN   RC_DN;
      R     "OUTPUTS DB".KILOTECK_Power_K2;
      R     T     52;
      L     3;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;
      JU    RC_DN;

RC_S3: A     T     53;
      JCN   RC_DN;
      L     4;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;
      JU    RC_DN;

RC_S4: R     "OUTPUTS DB".KILOTECK_Calib_K1;
      R     T     53;
      L     0;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;

RC_DN: NOP   0;

NETWORK
TITLE =Power-off sequence - K2 pulsed on for 3s, no K1 involved

      A     "GLUE SCALE CONTROL DB".Scale_PowerOff_Req;
      FP    "GLUE SCALE CONTROL DB".PowerOff_ReqMem;
      JCN   PO_STP;

      L     "GLUE SCALE CONTROL DB".PowerOff_Step;
      L     0;
      <>I   ;
      JC    PO_STP;
      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     0;
      <>I   ;
      JC    PO_STP;

      L     1;
      T     "GLUE SCALE CONTROL DB".PowerOff_Step;

PO_STP: L     "GLUE SCALE CONTROL DB".PowerOff_Step;
      L     1;
      ==I   ;
      JCN   PO_DN;

      S     "OUTPUTS DB".KILOTECK_Power_K2;
      L     S5T#3S;
      SD    T     54;
      A     T     54;
      JCN   PO_DN;
      R     "OUTPUTS DB".KILOTECK_Power_K2;
      R     T     54;
      L     0;
      T     "GLUE SCALE CONTROL DB".PowerOff_Step;

PO_DN: NOP   0;

END_FUNCTION
