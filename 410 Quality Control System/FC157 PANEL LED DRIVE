FUNCTION "PANEL LED DRIVE" : VOID
TITLE =Panel LED drive - GRN/RED/WHTx3 command-driven, standalone/reusable
// v0.1 - NEW, per Michou's request (2026-10-05): "a separate 'Panel LED
//   drive' Function ... Controlled by a Byte or Array of bool to: Scan 3
//   WHT LEds FWD/REV, each Independant or Panic Mode (Any ways to
//   impress), And GRN Solid/blink, RED Solid/blink." Drives the 5 lamp
//   bits in "OUTPUTS DB"/DB60 (GRN_LED_Pnl, RED_LED_Pnl, WHT_SWL_1/2/3_
//   Pnl) from the named command bits in "PANEL LED CMD DB"/DB107 - see
//   that file's header for the interface. Timers are FB556/DB108
//   "PANEL_LED_TIMERS_DB", called once per scan below, same proven
//   self-oscillating pattern as FC155's FB555 call.
//
//   White lamp priority (checked in this order, first match wins):
//     1. WHT_Panic   - all 3 lamps strobe together, fast (150ms)
//     2. WHT_ScanFwd/WHT_ScanRev - 1->2->3->1 or 3->2->1->3, 500ms/step
//     3. otherwise   - "independent" direct drive: WHT_1/2/3 mirrored
//        straight to the outputs (this is what Michou called "each
//        Independant")
//   GRN/RED: Blink bit overrides On/solid; neither bit = off.
//
//   Called from FC155 (its own "Drive Panel LED outputs" network, after
//   it sets WHT_ScanFwd/WHT_1/2/3/GRN_On/RED_On to reproduce its old
//   directly-driven lamp behavior) - no OB1 edit needed, FC155 was
//   already in the scan cycle. WHT_Panic/GRN_Blink/RED_Blink are NOT
//   touched by FC155, left free for independent/HMI/test-table control.
//   Block number FC157 - next free FC in this repo's visibility (FC156
//   was an earlier, now-deleted design; not reused to avoid confusion).
//   Not independently confirmed free against the live project's full
//   block list - same open caution as every other block number picked
//   this project (FB555/DB106, now FB556/DB107/DB108 too).
VERSION : 0.1


VAR_TEMP
  SCAN_IN : BOOL ;
  PANIC_IN : BOOL ;
  ALARM_IN : BOOL ;
END_VAR
BEGIN
NETWORK
TITLE =Timers - compute each clock's IN condition, CALL FB556 "PANEL_LED_TIMERS" once, every scan

      A     "PANEL LED CMD DB".WHT_ScanFwd;
      O     "PANEL LED CMD DB".WHT_ScanRev;
      AN    "PANEL_LED_TIMERS_DB".SCAN_OUT;
      =     #SCAN_IN;

      A     "PANEL LED CMD DB".WHT_Panic;
      AN    "PANEL_LED_TIMERS_DB".PANIC_OUT;
      =     #PANIC_IN;

      A     "PANEL LED CMD DB".GRN_Blink;
      O     "PANEL LED CMD DB".RED_Blink;
      AN    "PANEL_LED_TIMERS_DB".ALARM_OUT;
      =     #ALARM_IN;

      CALL "PANEL_LED_TIMERS" , "PANEL_LED_TIMERS_DB"
           SCAN_IN          := #SCAN_IN,
           SCAN_IN_TIME     := T#500MS,
           PANIC_IN         := #PANIC_IN,
           PANIC_IN_TIME    := T#150MS,
           ALARM_IN         := #ALARM_IN,
           ALARM_IN_TIME    := T#500MS;

NETWORK
TITLE =White lamp scan step - advances on each SCAN clock pulse, FWD or REV, resets to 1 when idle

      A     "PANEL LED CMD DB".WHT_ScanFwd;
      O     "PANEL LED CMD DB".WHT_ScanRev;
      JCN   WRST;

      A     "PANEL_LED_TIMERS_DB".SCAN_OUT;
      JCN   WSDN;

      A     "PANEL LED CMD DB".WHT_ScanFwd;
      JCN   WREV;

      L     "PANEL LED CMD DB".WHT_ScanStep;
      L     3;
      >=I   ;
      JCN   WFIN;
      L     1;
      T     "PANEL LED CMD DB".WHT_ScanStep;
      JU    WSDN;

WFIN: L     "PANEL LED CMD DB".WHT_ScanStep;
      L     1;
      +I    ;
      T     "PANEL LED CMD DB".WHT_ScanStep;
      JU    WSDN;

WREV: L     "PANEL LED CMD DB".WHT_ScanStep;
      L     1;
      <=I   ;
      JCN   WRIN;
      L     3;
      T     "PANEL LED CMD DB".WHT_ScanStep;
      JU    WSDN;

WRIN: L     "PANEL LED CMD DB".WHT_ScanStep;
      L     1;
      -I    ;
      T     "PANEL LED CMD DB".WHT_ScanStep;
      JU    WSDN;

WRST: L     1;
      T     "PANEL LED CMD DB".WHT_ScanStep;

WSDN: NOP   0;

NETWORK
TITLE =White lamps - Panic overrides Scan overrides Independent direct drive

      A     "PANEL LED CMD DB".WHT_Panic;
      JC    WPAN;

      A     "PANEL LED CMD DB".WHT_ScanFwd;
      O     "PANEL LED CMD DB".WHT_ScanRev;
      JC    WSCN;

      A     "PANEL LED CMD DB".WHT_1;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl;
      A     "PANEL LED CMD DB".WHT_2;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl;
      A     "PANEL LED CMD DB".WHT_3;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl;
      JU    WLDN;

WPAN: A     "PANEL_LED_TIMERS_DB".PANIC_OUT;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl;
      JU    WLDN;

WSCN: L     "PANEL LED CMD DB".WHT_ScanStep;
      L     1;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl;

      L     "PANEL LED CMD DB".WHT_ScanStep;
      L     2;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl;

      L     "PANEL LED CMD DB".WHT_ScanStep;
      L     3;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl;

WLDN: NOP   0;

NETWORK
TITLE =Green lamp - Blink overrides On/solid, neither = off

      A     "PANEL LED CMD DB".GRN_Blink;
      JC    GBLK;

      A     "PANEL LED CMD DB".GRN_On;
      =     "OUTPUTS DB".GRN_LED_Pnl;
      JU    GLDN;

GBLK: A     "PANEL_LED_TIMERS_DB".ALARM_OUT;
      =     "OUTPUTS DB".GRN_LED_Pnl;

GLDN: NOP   0;

NETWORK
TITLE =Red lamp - Blink overrides On/solid, neither = off

      A     "PANEL LED CMD DB".RED_Blink;
      JC    RBLK;

      A     "PANEL LED CMD DB".RED_On;
      =     "OUTPUTS DB".RED_LED_Pnl;
      JU    RLDN;

RBLK: A     "PANEL_LED_TIMERS_DB".ALARM_OUT;
      =     "OUTPUTS DB".RED_LED_Pnl;

RLDN: NOP   0;

END_FUNCTION
