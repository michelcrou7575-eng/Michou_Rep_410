FUNCTION "GLUE SCALE LOGIC" : VOID
TITLE =Glue Scale: DP Read, ASCII Parse, Pump Control, Alarms, KWS CY300 power/calibration FC155
// History (full blow-by-blow in git log, this comment block was
// trimmed after it grew past STEP7's title/comment size limit and
// started failing to compile - "Byte offset/number too big" at the
// VERSION line. Keep future entries short.):
//
// v0.11-v0.14: simplified the ASCII parse loop (indirect addressing,
//   replacing 7 hand-unrolled digit blocks), added scale-fault sentinel
//   detection (NegativeUnderScore_Value), HMI alarm reset, REAL->INT
//   conversion for weight/setpoints.
// v0.15-v0.17: HMI DB (DB10) bridge - setpoints, live weight,
//   transfered-weight calc, bottomer-velocity mirror, drove the real
//   pump output (nothing did before this - Glue_Fill_Pump_ON was
//   declared but unused).
// v0.18-v0.19: Valve_Open renamed Pump_ON throughout (drives a pump,
//   never a valve); reconciled against Michou's own parallel online
//   rebuild; overfill/underfill now interlock the pump; added lamp scan
//   pattern (WHT_SWL_1/2/3) and alarm lamps (RED_LED/GRN_LED).
// v0.20-v0.21: added PlatformMinWeight_SP sanity check (GrossWeight_Actual
//   must exceed the empty platform's ~30kg dead weight) and an
//   unconditional scale-fault pump interlock (active stop, not just a
//   frozen last-state hold). Confirmed scale-fault sentinel is INT
//   -20663 (not DINT 5222222 as first assumed).
// v0.22-v0.24: folded the separate FC156 power-up-calibration logic in
//   here; recalibration powers the scale off first (3s K2 pulse) before
//   the K1-then-K2-on cycle; fixed real STEP7 compile errors (jump
//   labels >4 chars/underscores, RED_LED/GRN_LED -> _Pnl, this header's
//   own size); trimmed this header for the first time.
//
// v0.25 changes vs v0.24 - reconciled against Michou's own further
//   online edits (2026-10-02) and fixed a real bug he found ("ReCalib_Step
//   goes to value 3 and stuck"):
//   - BUG FIX: RCS1/RCS2/RCS3/RCS5 each start with an S/SD/R "coil"
//     instruction immediately after a JC-jumped-to label, with no
//     explicit SET; before it. This file's own OWN pre-existing pump-
//     control network (OPEN/TRXF/CLOS) and the White-lamps network
//     (WTON) already establish the pattern this needs: RLO can't be
//     trusted to be 1 just because a jump landed there, so S/R/SD coils
//     right after a label need an explicit SET; first. RCS4 didn't need
//     it (starts with A, a bit-logic instruction that loads fresh
//     regardless). Added SET; to the other four. This is the most
//     likely cause of the stuck-step symptom, but not certain - flagged
//     to Michou: if steps still stick after this, the next suspect is a
//     Timer 52 collision with something elsewhere in the live project
//     this repo can't see (same risk class as T50/T51's original
//     caution, never fully closed out for T52-T56 either).
//   - Dropped a stray `L "Timer 54";` in RCS1 that loaded the timer's
//     current value and did nothing with it (dead code, harmless but
//     pointless - the following `A "Timer 54"` already reads its
//     status fresh regardless of what came before).
//   - Adopted Michou's further online changes verbatim: VAR_TEMP names
//     (RetVal1->RET_VALUE_1 etc.), a NEW "Update" network
//     (#UPDATE := rising edge of "M 6.7", via "FP 201.2") that now
//     gates "Compute transfered weight.../Bottomer_Velocity",
//     "Detect scale fault", "Platform weight sanity check" and
//     "Overfill alarm" behind `Pump_ON OR #UPDATE` (scale-fault and
//     platform checks previously ran every scan unconditionally -
//     FLAGGED: confirm this is intentional, since it means those two
//     safety checks now only evaluate when the pump is running or on an
//     M6.7 edge, not continuously); timers T50-T54 now referenced via
//     symbolic "Timer NN" names (T55/T56 still raw - not yet symbolized
//     in the live project, left as-is rather than guessing a symbol
//     that doesn't exist yet, same lesson as the RED_LED mistake).
//   - WHT_SWL_1/2/3 -> WHT_SWL_1_Pnl/2_Pnl/3_Pnl: Michou's paste uses
//     the _Pnl suffix for these too now (not just RED_LED/GRN_LED as
//     the v0.24 compile log alone suggested) - adopted, DB60 updated to
//     match.
VERSION : 0.25


VAR_TEMP
  RET_VALUE_1 : INT ;
  RET_VALUE_2 : INT ;
  CHAR_VALUE : INT ;
  LOOP_INDEX : INT ;
  INT_PART : DINT ;
  FOUND_DIGIT : BOOL ;
  UPDATE : BOOL ;
END_VAR
BEGIN
NETWORK
TITLE =Sync HMI setpoints -> scale setpoints (unconditional, every scan)
// Only these fields correspond between "HMI DB" and DB105 - see v0.15/
// v0.18 changelogs for why the other same-offset fields must NOT be
// copied this way.
      L     "HMI DB".Fill_Start_Weight_SP;
      T     "GLUE SCALE CONTROL DB".Fill_Start_SP;

      L     "HMI DB".Fill_Stop_Weight_SP;
      T     "GLUE SCALE CONTROL DB".Fill_Stop_SP;

      L     "HMI DB".AlarmLimit_Overfill_SP;
      T     "GLUE SCALE CONTROL DB".AlarmLimit_Overfill_SP;

      L     "HMI DB".AlarmLimit_Underfill_SP;
      T     "GLUE SCALE CONTROL DB".AlarmLimit_Underfill_SP;

NETWORK
TITLE =Update

      A     "M 6.7";
      FP    "FP 201.2";
      =     #UPDATE;

NETWORK
TITLE =Compute transfered weight and mirror bottomer velocity to HMI DB
// Actual_Transfered_Weight = current weight minus the weight snapshot
// taken at the last pump-start (GrossWeight_Actual_Mem) - see the
// "Pump control" network below for where that snapshot is taken.
// Bottomer_Velocity mirrors the 410 seam-AGC subsystem's own filtered
// web velocity (DB640/"RUN_DATA_DB", owned by FC120/FB610).
      A     "GLUE SCALE CONTROL DB".Pump_ON;
      O     #UPDATE;
      JCN   UDT0;

      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual;
      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual_Mem;
      -I    ;
      T     "HMI DB".Actual_Transfered_Weight;

      L     "RUN_DATA_DB".Web_Velocity_Filtered;
      RND   ;
      T     "HMI DB".Bottomer_Velocity;

UDT0: NOP   0;

NETWORK
TITLE =Read 16-byte consistent block (IB272-287) via DPRD_DAT

      CALL "DPRD_DAT" (
           LADDR                    := W#16#110,
           RET_VAL                  := #RET_VALUE_1,
           RECORD                   := P#DB4.DBX0.0 BYTE 16);

NETWORK
TITLE =Read 4-byte consistent block (IB289-292) via DPRD_DAT

      CALL "DPRD_DAT" (
           LADDR                    := W#16#121,
           RET_VAL                  := #RET_VALUE_2,
           RECORD                   := P#DB4.DBX16.0 BYTE 4);

NETWORK
TITLE =Validate telegram - check RetVal and fixed markers

      L     #RET_VALUE_1;
      L     0;
      <>I   ;
      L     #RET_VALUE_2;
      L     0;
      <>I   ;
      OW    ;
      L     "ABC3000A_DB".Byte_7;
      L     B#16#2E;
      <>I   ;
      OW    ;
      L     "ABC3000A_DB".Byte_9;
      L     B#16#6B;
      <>I   ;
      OW    ;
      L     "ABC3000A_DB".Byte_10;
      L     B#16#67;
      <>I   ;
      OW    ;
      =     "GLUE SCALE CONTROL DB".ParseError;

NETWORK
TITLE =Parse integer part, Byte_0-5 - loop, skip leading spaces until first digit

      CLR   ;
      =     #FOUND_DIGIT;
      L     0;
      T     #INT_PART;

      OPN   "ABC3000A_DB";
      LAR1  P#0.0;

      L     6;
LP1:  T     #LOOP_INDEX;

      L     DBB [AR1,P#0.0];
      L     B#16#20;
      <>I   ;
      S     #FOUND_DIGIT;

      A     #FOUND_DIGIT;
      JCN   ND1;

      L     DBB [AR1,P#0.0];
      L     B#16#30;
      -I    ;
      T     #CHAR_VALUE;
      L     #INT_PART;
      L     10;
      *D    ;
      L     #CHAR_VALUE;
      ITD   ;
      +D    ;
      T     #INT_PART;

ND1:  +AR1  P#1.0;

      L     #LOOP_INDEX;
      LOOP  LP1;

NETWORK
TITLE =Parse integer part, Byte_6 - field's last position, always a digit

      L     "ABC3000A_DB".Byte_6;
      L     B#16#30;
      -I    ;
      T     #CHAR_VALUE;
      L     #INT_PART;
      L     10;
      *D    ;
      L     #CHAR_VALUE;
      ITD   ;
      +D    ;
      T     #INT_PART;

NETWORK
TITLE =Store final weight - Byte_8's decimal digit is discarded, INT resolution is 1kg

      L     #INT_PART;
      T     "GLUE SCALE CONTROL DB".GrossWeight_Actual;

NETWORK
TITLE =Detect scale fault - GrossWeight_Actual matches the scale's negative-value sentinel (latching)
// Confirmed by Michou: -20663 is the real INT value the KWS CY300
// gives when its reading goes negative. Runs on the already-stored
// INT GrossWeight_Actual - -20663 fits fine in 16-bit INT range.
// FLAGGED (v0.25): now gated on #UPDATE (M6.7 edge) only, not every
// scan unconditionally as before - confirm this is intentional for a
// fault check.
      O     #UPDATE;
      JCN   UDT1;

      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual;
      L     "GLUE SCALE CONTROL DB".NegativeUnderScore_Value;
      ==I   ;
      S     "GLUE SCALE CONTROL DB".Alarm_ScaleFault;

UDT1: NOP   0;

NETWORK
TITLE =Platform weight sanity check - GrossWeight_Actual must exceed the empty platform's own dead weight
// The platform itself (nothing on it) weighs at least PlatformMinWeight_SP
// (30kg) - a GROSS reading below that is implausible and means the
// reading can't be trusted, not a real underfill. Same alarm bit as the
// sentinel check above. FLAGGED (v0.25): now gated on Pump_ON OR
// #UPDATE, not every scan - confirm intentional.
      A     "GLUE SCALE CONTROL DB".Pump_ON;
      O     #UPDATE;
      JCN   UDT2;

      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual;
      L     "GLUE SCALE CONTROL DB".PlatformMinWeight_SP;
      <I    ;
      S     "GLUE SCALE CONTROL DB".Alarm_ScaleFault;

UDT2: NOP   0;

NETWORK
TITLE =Mirror parsed weight -> HMI DB (unconditional, for display)

      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual;
      T     "HMI DB".Actual_Glue_Weight;

NETWORK
TITLE =Skip valve/alarm update if parse failed or scale fault latched this scan

      A     "GLUE SCALE CONTROL DB".ParseError;
      O     "GLUE SCALE CONTROL DB".Alarm_ScaleFault;
      JC    SKIP;

NETWORK
TITLE =Pump control - turns on below Fill_Start_SP, off at/above Fill_Stop_SP

      A     "GLUE SCALE CONTROL DB".Pump_ON;
      JC    CHKC;

      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual;
      L     "GLUE SCALE CONTROL DB".Fill_Start_SP;
      <I    ;
      JC    OPEN;
      JU    NXT1;

CHKC: L     "GLUE SCALE CONTROL DB".GrossWeight_Actual;
      L     "GLUE SCALE CONTROL DB".Fill_Stop_SP;
      >=I   ;
      JC    CLOS;
      JU    NXT1;

OPEN: FP    "FP 201.0"; // edge memory - fires once, the scan Pump_ON is newly commanded on
      JCN   TRXF;
      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual; // snapshot weight at pump-start for Actual_Transfered_Weight
      T     "GLUE SCALE CONTROL DB".GrossWeight_Actual_Mem;

TRXF: SET   ;
      S     "GLUE SCALE CONTROL DB".Pump_ON;
      JU    NXT1;

CLOS: SET   ;
      R     "GLUE SCALE CONTROL DB".Pump_ON;

NXT1: NOP   0;

NETWORK
TITLE =Overfill alarm - latching, set on exceed, no auto-reset here
// FLAGGED (v0.25): now gated on Pump_ON OR #UPDATE, not every scan -
// confirm intentional.
      A     "GLUE SCALE CONTROL DB".Pump_ON;
      O     #UPDATE;
      JCN   NPMP;

      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual;
      L     "GLUE SCALE CONTROL DB".AlarmLimit_Overfill_SP;
      >I    ;
      S     "GLUE SCALE CONTROL DB".Alarm_Overfill;

NPMP: NOP   0;

NETWORK
TITLE =Underfill check - start 5s settle timer on pump-off (falling edge)

      A     "GLUE SCALE CONTROL DB".Pump_ON_Prev;
      AN    "GLUE SCALE CONTROL DB".Pump_ON;
      L     S5T#5S;
      SD    "Timer 50";

      A     "GLUE SCALE CONTROL DB".Pump_ON;
      =     "GLUE SCALE CONTROL DB".Pump_ON_Prev;

NETWORK
TITLE =Underfill alarm - latch if weight still below limit after T50

      A     "Timer 50";
      JCN   SKPU;

      L     "GLUE SCALE CONTROL DB".GrossWeight_Actual;
      L     "GLUE SCALE CONTROL DB".AlarmLimit_Underfill_SP;
      <I    ;
      S     "GLUE SCALE CONTROL DB".Alarm_Underfill;

SKPU: NOP   0;

NETWORK
TITLE =Overfill/Underfill interlock - blocks the pump while either is latched
// Overfill: an immediate safety stop if weight somehow exceeds the max
// even though Fill_Stop_SP should already have closed the pump.
// Underfill only ever latches after the pump has already stopped, so
// "controls the pump" here means blocking automatic re-engagement, not
// an immediate stop - both read the same way: force Pump_ON off and
// keep it off while either alarm (or Alarm_ScaleFault) is latched,
// until Reset_Alarms clears it.
      A     "GLUE SCALE CONTROL DB".Alarm_Overfill;
      O     "GLUE SCALE CONTROL DB".Alarm_Underfill;
      O     "GLUE SCALE CONTROL DB".Alarm_ScaleFault;
      R     "GLUE SCALE CONTROL DB".Pump_ON;

NETWORK
TITLE =Exit point for parse-error skip

SKIP: NOP   0;

NETWORK
TITLE =Reset latched alarms - HMI-driven, runs regardless of this scan's skip state

      A     "GLUE SCALE CONTROL DB".Reset_Alarms;
      R     "GLUE SCALE CONTROL DB".Alarm_Overfill;
      R     "GLUE SCALE CONTROL DB".Alarm_Underfill;
      R     "GLUE SCALE CONTROL DB".Alarm_ScaleFault;

NETWORK
TITLE =Drive physical glue pump output - automatic Pump_ON, Glue_Fill_Pump_Test overrides it on

      A     "GLUE SCALE CONTROL DB".Pump_ON;
      O     "HMI DB".Glue_Fill_Pump_Test;
      =     "HMI DB".Glue_Fill_Pump_ON;

NETWORK
TITLE =Lamp scan clock - one-scan pulse every 500ms while Pump_ON (standard SD-timer flasher idiom)
// LampScanClockMem toggles high for exactly one scan every 500ms as
// long as Pump_ON stays true: SD T51 only (re)starts on a rising edge
// of its own enable rung; while LampScanClockMem is FALSE the rung
// stays enabled and the stored timer counts down untouched by repeat
// calls, then on elapse T51.Q goes TRUE, LampScanClockMem latches TRUE
// for that one scan and T51 is immediately reset. Not bench-verified.
      A     "GLUE SCALE CONTROL DB".Pump_ON;
      AN    "GLUE SCALE CONTROL DB".LampScanClockMem;
      L     S5T#500MS;
      SD    "Timer 51";

      A     "Timer 51";
      =     "GLUE SCALE CONTROL DB".LampScanClockMem;
      R     "Timer 51";

NETWORK
TITLE =Lamp scan step - advances 1->2->3->1 on each clock pulse, resets to 1 when the pump stops

      A     "GLUE SCALE CONTROL DB".Pump_ON;
      JCN   LSRS;

      A     "GLUE SCALE CONTROL DB".LampScanClockMem;
      JCN   LSDN;

      L     "GLUE SCALE CONTROL DB".LampScanStep;
      L     3;
      >=I   ;
      JCN   LSIN;
      L     1;
      T     "GLUE SCALE CONTROL DB".LampScanStep;
      JU    LSDN;

LSIN: L     "GLUE SCALE CONTROL DB".LampScanStep;
      L     1;
      +I    ;
      T     "GLUE SCALE CONTROL DB".LampScanStep;
      JU    LSDN;

LSRS: SET   ;
      L     1;
      T     "GLUE SCALE CONTROL DB".LampScanStep;
      R     "Timer 51";
      CLR   ;
      =     "GLUE SCALE CONTROL DB".LampScanClockMem;

LSDN: NOP   0;

NETWORK
TITLE =White lamps - Glue_Fill_Pump_Test forces all three on, else scan while Pump_ON, else off

      A     "HMI DB".Glue_Fill_Pump_Test;
      JC    WTON;

      A     "GLUE SCALE CONTROL DB".Pump_ON;
      JC    WSCN;

      CLR   ;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl;
      JU    WLDN;

WTON: SET   ;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl;
      JU    WLDN;

WSCN: L     "GLUE SCALE CONTROL DB".LampScanStep;
      L     1;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl;

      L     "GLUE SCALE CONTROL DB".LampScanStep;
      L     2;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl;

      L     "GLUE SCALE CONTROL DB".LampScanStep;
      L     3;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl;

WLDN: NOP   0;

NETWORK
TITLE =Power-on + calibrate sequence - powers the scale off first, then K1 on for a flat 5s, K2 pulsed 0.5s inside that window
// KWS CY300 power-up defect workaround: the scale resets its zero/
// calibration reference every power-up. Closing the calibration shunt
// (K1) BEFORE power-cycling the scale (K2) means the scale sees the
// known shunt reference the moment it boots. K2 is a momentary
// button-press simulation - a SHORT 0.5s pulse powers the scale ON, a
// LONG 3s pulse powers it OFF. Recalibrating needs a full power cycle,
// so step 1 pulses K2 for 3s (power OFF, reusing T54) before K1
// engages and the power-on+calibrate cycle runs.
//   ReCalib_Step: 0 idle, 1 K2 3s power-off pulse (T54), 2 K1 on/T53
//   (5s hold) started, 3 K2 0.5s power-on pulse (T52), 4 waiting for
//   T53 to elapse, 5 K1 off/done.
// v0.25: added SET; before the S/SD/R coil at the start of RCS1/RCS2/
// RCS3/RCS5 (each reached via a JC jump, which can't be trusted to
// leave RLO=1 - same reasoning as TRXF/CLOS/WTON above). Likely fix for
// Michou's "ReCalib_Step stuck at 3" report, not fully confirmed - if
// it still sticks, check whether Timer 52 is used elsewhere in the live
// project.
      A     "GLUE SCALE CONTROL DB".Scale_ReCalib_Req;
      FP    "FP 201.1";
      JCN   RCST;

      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     0;
      <>I   ;
      JC    RCST;

      L     1;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;

RCST: L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     1;
      ==I   ;
      JC    RCS1;

      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     2;
      ==I   ;
      JC    RCS2;

      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     3;
      ==I   ;
      JC    RCS3;

      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     4;
      ==I   ;
      JC    RCS4;

      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     5;
      ==I   ;
      JC    RCS5;
      JU    RCDN;

RCS1: SET   ;
      S     "OUTPUTS DB".KILOTECK_Power_K2; // Power Off
      L     S5T#3S;
      SD    "Timer 54";

      A     "Timer 54";
      JCN   RCDN;
      R     "OUTPUTS DB".KILOTECK_Power_K2;
      R     "Timer 54";
      L     2;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;
      JU    RCDN;

RCS2: SET   ;
      S     "OUTPUTS DB".KILOTECK_Calib_K1;
      L     S5T#5S;
      SD    "Timer 53";
      L     3;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;
      JU    RCDN;

RCS3: SET   ;
      S     "OUTPUTS DB".KILOTECK_Power_K2;
      L     S5T#500MS;
      SD    "Timer 52";

      A     "Timer 52";
      JCN   RCDN;
      R     "OUTPUTS DB".KILOTECK_Power_K2;
      R     "Timer 52";
      L     4;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;
      JU    RCDN;

RCS4: A     "Timer 53";
      JCN   RCDN;
      L     5;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;
      JU    RCDN;

RCS5: SET   ;
      R     "OUTPUTS DB".KILOTECK_Calib_K1;
      R     "Timer 53";
      L     0;
      T     "GLUE SCALE CONTROL DB".ReCalib_Step;

RCDN: NOP   0;

NETWORK
TITLE =Manual power-off pulse - 3s K2 pulse on Scale_PowerOFF_Pulse, auto-clears when done
// No step counter needed for a single timed action. Calling SD
// directly off this bit's own level is safe without separate edge
// memory: SD only truly (re)starts on a rising edge of its enable rung.
// Ignored while ReCalib_Step is mid-sequence. Auto-clears
// Scale_PowerOFF_Pulse when the pulse completes.
      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     0;
      <>I   ;
      JC    PFDN;

      A     "GLUE SCALE CONTROL DB".Scale_PowerOFF_Pulse;
      JCN   PFDN;

      S     "OUTPUTS DB".KILOTECK_Power_K2;
      L     S5T#3S;
      SD    T     56;
      A     T     56;
      JCN   PFDN;
      R     "OUTPUTS DB".KILOTECK_Power_K2;
      R     T     56;
      CLR   ;
      =     "GLUE SCALE CONTROL DB".Scale_PowerOFF_Pulse;

PFDN: NOP   0;

NETWORK
TITLE =Manual power-on pulse - 500ms K2 pulse on Scale_PowerON_Pulse, auto-clears when done
// Same idiom as the power-off pulse above, short pulse instead of long.
// Ignored while ReCalib_Step is mid-sequence.
      L     "GLUE SCALE CONTROL DB".ReCalib_Step;
      L     0;
      <>I   ;
      JC    PNDN;

      A     "GLUE SCALE CONTROL DB".Scale_PowerON_Pulse;
      JCN   PNDN;

      S     "OUTPUTS DB".KILOTECK_Power_K2;
      L     S5T#500MS;
      SD    T     55;
      A     T     55;
      JCN   PNDN;
      R     "OUTPUTS DB".KILOTECK_Power_K2;
      R     T     55;
      CLR   ;
      =     "GLUE SCALE CONTROL DB".Scale_PowerON_Pulse;

PNDN: NOP   0;

NETWORK
TITLE =Alarm lamps - RED_LED_Pnl if any alarm latched, GRN_LED_Pnl if none
// Extends beyond just Overfill/Underfill to include Alarm_ScaleFault.
      A     "GLUE SCALE CONTROL DB".Alarm_Overfill;
      O     "GLUE SCALE CONTROL DB".Alarm_Underfill;
      O     "GLUE SCALE CONTROL DB".Alarm_ScaleFault;
      =     "OUTPUTS DB".RED_LED_Pnl;

      NOT   ;
      =     "OUTPUTS DB".GRN_LED_Pnl;

END_FUNCTION
