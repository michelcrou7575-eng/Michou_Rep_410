FUNCTION_BLOCK "IEC TIMERS"
TITLE =IEC Timers
// v0.2 - Michou's own design (2026-10-03), per his question "Instead of
//   an FC, why not call all SFB4 inside an FB (with it's own instance
//   db) then call it once in FC155?" - wraps every timer FC155 needs as
//   a multi-instance child of this ONE FB, called once with ONE
//   instance DB, instead of 7 separate top-level instance DBs. Each
//   timer is "TON" - the IEC Timer library FB Michou imported into this
//   project from the Standard Library ("IEC Function Blocks") after
//   SFB4 failed to resolve on this CPU (compile log, 2026-10-02:
//   "Symbol PT not found in symbol table" etc. for every SFB4 call -
//   SFB2/3/4 aren't firmware-native on every S7-300 CPU, this one
//   needed the library FB instead). Assigned block number FB555 per
//   Michou.
//   Fixed one bug in the pasted version: TON_UNDERFILL's PT was wired
//   to #LAMP_IN_TIME (copy-paste leftover from the TON_LAMPSCAN call
//   above it) instead of #UNDERFILL_IN_TIME - would have given the
//   underfill settle timer a 500ms preset instead of 5s. See FC155
//   v0.27 for how this FB is called (every IN/PT computed and passed
//   fresh every scan - see that file's own v0.26/v0.27 changelog for
//   why SFB4-family timers need to be called every scan, not just once
//   per state-machine step).
//
// v0.3 - comment-only, no code change: FC155 v0.28 corrected the
//   power-on/calibration sequence (Michou, 2026-10-03 - K1+K2 now start
//   simultaneously as "Process ON", 5s K2-alone power-off, new 3s dwell
//   wait) and, as part of that, repurposes the TON_PWR_ON instance
//   (PWRON_IN/PWRON_IN_TIME/PWRON_OUT) as the new 3s dwell-wait timer -
//   it's no longer a standalone "power the scale on" pulse, since
//   Scale_PowerON_Pulse now runs the shared "Process ON" step instead.
//   No interface change here was needed for that - FC155 just feeds
//   different IN/PT values into the same PWRON_IN/PWRON_IN_TIME slot.
//   See FC155's own changelog for the full reasoning.
//
// v0.4 - per Michou (2026-10-06): "Need a 30 sec delay before
//   restarting after power has resumed ... Stabilisation." Added an 8th
//   timer, TON_STARTUP (STARTUP_IN/STARTUP_IN_TIME/STARTUP_OUT) - FC155
//   feeds it a one-shot latch (FALSE for exactly the first scan after
//   OB100 resets it, TRUE forever after) so it measures time elapsed
//   since the most recent restart, once, reliably - not a stale
//   carryover from a previous power cycle (the instance DB's own actual
//   values are battery/cap-backed same as any other DB, so without that
//   one-scan FALSE pulse this timer's Q could already read TRUE on a
//   fresh restart). See FC155 v0.30 for how STARTUP_OUT auto-triggers
//   the recalibration sequence and DB105 v0.18 / OB100's own changelog
//   for the full reasoning.
//
// v0.5 - Michou renamed this block's own symbol directly in STEP7,
//   matching his convention for every other named block in the project
//   (spaces, not underscores - "OUTPUTS DB", "GLUE SCALE CONTROL DB",
//   "PANEL LED CMD DB", etc.): "IEC_TIMERS" -> "IEC TIMERS". Reconciled
//   here after his "Refactor glue scale logic" export (2026-10-06)
//   showed FC155 already calling it by the new name. Rename only, no
//   logic change - see the instance DB's own changelog for the
//   matching rename.
//
// v0.6 - per Michou (2026-10-06): "DB106 Db108 not needed! FB555
//   Instance is DB555, FB556 Instance is DB556!!!" This FB's instance DB
//   is renumbered DB106 -> DB555 (matching this FB's own number, his
//   preferred convention) - see DB555_IEC_TIMERS_DB.awl's own
//   changelog. No change to this file itself (an FB doesn't declare its
//   instance DB's number).
//
// v0.7 - per Michou (2026-10-06): "Underfill Alarm should go off even
//   when pump is running! Could be a leak! ... there should be a timing
//   alarm too: If Fill take too long or if the glue Barrel is emptying
//   too fast." Added 3 timers for FC155's new leak-detection networks
//   (see that file's own changelog for the full logic):
//   - TON_FILLSTALL: no measurable fill progress for too long while
//     Pump_ON - self-resetting (FC155 zeroes FILLSTALL_IN whenever
//     progress is detected, restarting the clock), PT is how long zero
//     progress is tolerated before alarming.
//   - TON_FILLTIME: Pump_ON continuously too long overall, even if
//     weight is still slowly rising - complements TON_FILLSTALL, which
//     only catches a complete stall, not an abnormally slow fill.
//   - TON_DRAINCHK: free-running periodic pulse (same self-oscillating
//     idiom as TON_LAMPSCAN) pacing FC155's idle rapid-drain check,
//     while Pump_ON is false.
//   All 3 PT values FC155 feeds are PLACEHOLDERS - this repo has no way
//   to know the real fill rate or normal idle consumption rate.
VERSION : 0.7


VAR_INPUT
  LAMP_IN : BOOL ;
  LAMP_IN_TIME : TIME ;
  UNDERFILL_IN : BOOL ;
  UNDERFILL_IN_TIME : TIME ;
  RC_K2OFF_IN : BOOL ;
  RC_K2OFF_IN_TIME : TIME ;
  RC_K1HOLD_IN : BOOL ;
  RC_K1HOLD_IN_TIME : TIME ;
  RC_K2ON_IN : BOOL ;
  RC_K2ON_IN_TIME : TIME ;
  PWRON_IN : BOOL ;
  PWRON_IN_TIME : TIME ;
  PWROFF_IN : BOOL ;
  PWROFF_IN_TIME : TIME ;
  STARTUP_IN : BOOL ;
  STARTUP_IN_TIME : TIME ;
  FILLSTALL_IN : BOOL ;
  FILLSTALL_IN_TIME : TIME ;
  FILLTIME_IN : BOOL ;
  FILLTIME_IN_TIME : TIME ;
  DRAINCHK_IN : BOOL ;
  DRAINCHK_IN_TIME : TIME ;
END_VAR
VAR_OUTPUT
  LAMP_OUT : BOOL ;
  UNDERFILL_OUT : BOOL ;
  RC_K2OFF_OUT : BOOL ;
  RC_K1HOLD_OUT : BOOL ;
  RC_K2ON_OUT : BOOL ;
  PWRON_OUT : BOOL ;
  PWROFF_OUT : BOOL ;
  STARTUP_OUT : BOOL ;
  FILLSTALL_OUT : BOOL ;
  FILLTIME_OUT : BOOL ;
  DRAINCHK_OUT : BOOL ;
END_VAR
VAR
  TON_UNDERFILL : "TON";
  TON_LAMPSCAN : "TON";
  TON_RC_K1HOLD : "TON";
  TON_RC_K2ON : "TON";
  TON_PWR_ON : "TON";
  TON_RC_K2OFF : "TON";
  TON_PWR_OFF : "TON";
  TON_STARTUP : "TON";
  TON_FILLSTALL : "TON";
  TON_FILLTIME : "TON";
  TON_DRAINCHK : "TON";
END_VAR
BEGIN
NETWORK
TITLE =Timers

      CALL #TON_LAMPSCAN (
           IN                       := #LAMP_IN,
           PT                       := #LAMP_IN_TIME,
           Q                        := #LAMP_OUT);

      CALL #TON_UNDERFILL (
           IN                       := #UNDERFILL_IN,
           PT                       := #UNDERFILL_IN_TIME,
           Q                        := #UNDERFILL_OUT);

      CALL #TON_RC_K2OFF (
           IN                       := #RC_K2OFF_IN,
           PT                       := #RC_K2OFF_IN_TIME,
           Q                        := #RC_K2OFF_OUT);

      CALL #TON_RC_K1HOLD (
           IN                       := #RC_K1HOLD_IN,
           PT                       := #RC_K1HOLD_IN_TIME,
           Q                        := #RC_K1HOLD_OUT);

      CALL #TON_RC_K2ON (
           IN                       := #RC_K2ON_IN,
           PT                       := #RC_K2ON_IN_TIME,
           Q                        := #RC_K2ON_OUT);

      CALL #TON_PWR_ON (
           IN                       := #PWRON_IN,
           PT                       := #PWRON_IN_TIME,
           Q                        := #PWRON_OUT);

      CALL #TON_PWR_OFF (
           IN                       := #PWROFF_IN,
           PT                       := #PWROFF_IN_TIME,
           Q                        := #PWROFF_OUT);

      CALL #TON_STARTUP (
           IN                       := #STARTUP_IN,
           PT                       := #STARTUP_IN_TIME,
           Q                        := #STARTUP_OUT);

      CALL #TON_FILLSTALL (
           IN                       := #FILLSTALL_IN,
           PT                       := #FILLSTALL_IN_TIME,
           Q                        := #FILLSTALL_OUT);

      CALL #TON_FILLTIME (
           IN                       := #FILLTIME_IN,
           PT                       := #FILLTIME_IN_TIME,
           Q                        := #FILLTIME_OUT);

      CALL #TON_DRAINCHK (
           IN                       := #DRAINCHK_IN,
           PT                       := #DRAINCHK_IN_TIME,
           Q                        := #DRAINCHK_OUT);

END_FUNCTION_BLOCK
