FUNCTION "SCALE PANEL LAMPS" : VOID
TITLE =Panel LED drive - GRN/RED/WHTx3 command-driven, standalone/reusable
// v0.1 - NEW, per Michou's request (2026-10-05): "a separate 'Panel LED
//   drive' Function ... Controlled by a Byte or Array of bool to: Scan 3
//   WHT LEds FWD/REV, each Independant or Panic Mode (Any ways to
//   impress), And GRN Solid/blink, RED Solid/blink." Drives the 5 lamp
//   bits in "OUTPUTS DB"/DB60 from the named command bits in "PANEL LED
//   CMD DB"/DB107 - see that file's header for the interface. Timers are
//   FB556/DB556, called once per scan below, same proven self-
//   oscillating pattern as FC155's FB555 call.
//
//   White lamp priority (checked in this order, first match wins):
//     1. WHT_Panic   - all 3 lamps strobe together, fast (150ms)
//     2. WHT_ScanFwd/WHT_ScanRev - 1->2->3->1 or 3->2->1->3, 500ms/step
//     3. otherwise   - "independent" direct drive: WHT_1/2/3 mirrored
//        straight to the outputs (this is what Michou called "each
//        Independant")
//   GRN/RED: Blink bit overrides On/solid; neither bit = off.
//
// v0.2 - reconciled against Michou's own live edits (2026-10-06):
//   - Block renumbered FC157 -> FC158 (FC157 wasn't actually free on the
//     live project) and renamed "PANEL LED DRIVE" -> "SCALE PANEL
//     LAMPS" - confirms FC157's block-number was never independently
//     verified free, flagged since v0.1.
//   - FB556/DB108's own symbols renamed to use spaces, not underscores,
//     matching Michou's convention for every other named block - this
//     file's CALL/field references updated to match.
//   - DB60 v0.5 renamed the three white-lamp outputs to match their
//     real switch function: WHT_SWL_1/2/3_Pnl -> _Pnl_Pump_Test/_Pnl_
//     Calib/_Pnl_Alrm_Ack - all references here updated to match.
//
// v0.3 - per Michou (2026-10-06): "DB106 Db108 not needed! FB555
//   Instance is DB555, FB556 Instance is DB556!!!" FB556's instance DB
//   is renumbered DB108 -> DB556 (matching FB556's own number) - this
//   file's CALL/field references updated to match (see FB556/
//   DB556_PANEL_LED_TIMERS_DB.awl's own changelogs).
//
// v0.4 - per Michou (2026-10-06): "the RED Lamp is pulsing when Fault!
//   Need Blinking!" FB556's self-oscillating ALARM_IN/ALARM_OUT pattern
//   (same idiom as SCAN/PANIC) only holds Q true for ONE scan every
//   500ms (~2% duty cycle) - fine for a clock PULSE driving a step
//   counter, wrong for directly driving a lamp someone needs to actually
//   see: it reads as a brief flash, not a 50/50 blink. Green/Red lamps
//   now read "M 6.5" directly instead - the same clock-memory bit
//   Michou already used for the Calib-lamp blink (v0.33/v0.34), a real
//   50/50 square wave. ALARM_IN is no longer computed/passed to FB556;
//   TON_ALARM/ALARM_OUT are left declared there but unused - see that
//   file's own changelog.
VERSION : 0.4


VAR_TEMP
  SCAN_IN : BOOL ;
  PANIC_IN : BOOL ;
END_VAR
BEGIN
NETWORK
TITLE =Timers - compute each clock's IN condition, CALL FB556 "PANEL LED TIMERS" once, every scan

      A     "PANEL LED CMD DB".WHT_ScanFwd;
      O     "PANEL LED CMD DB".WHT_ScanRev;
      AN    "PANEL LED TIMERS DB".SCAN_OUT;
      =     #SCAN_IN;

      A     "PANEL LED CMD DB".WHT_Panic;
      AN    "PANEL LED TIMERS DB".PANIC_OUT;
      =     #PANIC_IN;

      CALL "PANEL LED TIMERS" , "PANEL LED TIMERS DB" (
           SCAN_IN                  := #SCAN_IN,
           SCAN_IN_TIME             := T#500MS,
           PANIC_IN                 := #PANIC_IN,
           PANIC_IN_TIME            := T#150MS);

NETWORK
TITLE =White lamp scan step - advances on each SCAN clock pulse, FWD or REV, resets to 1 when idle

      A     "PANEL LED CMD DB".WHT_ScanFwd;
      O     "PANEL LED CMD DB".WHT_ScanRev;
      JCN   WRST;

      A     "PANEL LED TIMERS DB".SCAN_OUT;
      JCN   WSDN;

      A     "PANEL LED CMD DB".WHT_ScanFwd;
      JCN   WREV;

      L     "PANEL LED CMD DB".WHT_ScanStep;
      L     3;
      >=I   ;
      JCN   WFIN;
      L     1;
      T     "PANEL LED CMD DB".WHT_ScanStep;
      JU    WSDN;

WFIN: L     "PANEL LED CMD DB".WHT_ScanStep;
      L     1;
      +I    ;
      T     "PANEL LED CMD DB".WHT_ScanStep;
      JU    WSDN;

WREV: L     "PANEL LED CMD DB".WHT_ScanStep;
      L     1;
      <=I   ;
      JCN   WRIN;
      L     3;
      T     "PANEL LED CMD DB".WHT_ScanStep;
      JU    WSDN;

WRIN: L     "PANEL LED CMD DB".WHT_ScanStep;
      L     1;
      -I    ;
      T     "PANEL LED CMD DB".WHT_ScanStep;
      JU    WSDN;

WRST: L     1;
      T     "PANEL LED CMD DB".WHT_ScanStep;

WSDN: NOP   0;

NETWORK
TITLE =White lamps - Panic overrides Scan overrides Independent direct drive

      A     "PANEL LED CMD DB".WHT_Panic;
      JC    WPAN;

      A     "PANEL LED CMD DB".WHT_ScanFwd;
      O     "PANEL LED CMD DB".WHT_ScanRev;
      JC    WSCN;

      A     "PANEL LED CMD DB".WHT_1;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl_Pump_Test;
      A     "PANEL LED CMD DB".WHT_2;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl_Calib;
      A     "PANEL LED CMD DB".WHT_3;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl_Alrm_Ack;
      JU    WLDN;

WPAN: A     "PANEL LED TIMERS DB".PANIC_OUT;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl_Pump_Test;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl_Calib;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl_Alrm_Ack;
      JU    WLDN;

WSCN: L     "PANEL LED CMD DB".WHT_ScanStep;
      L     1;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_1_Pnl_Pump_Test;

      L     "PANEL LED CMD DB".WHT_ScanStep;
      L     2;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_2_Pnl_Calib;

      L     "PANEL LED CMD DB".WHT_ScanStep;
      L     3;
      ==I   ;
      =     "OUTPUTS DB".WHT_SWL_3_Pnl_Alrm_Ack;

WLDN: NOP   0;

NETWORK
TITLE =Green lamp - Blink overrides On/solid, neither = off

      A     "PANEL LED CMD DB".GRN_Blink;
      JC    GBLK;

      A     "PANEL LED CMD DB".GRN_On;
      =     "OUTPUTS DB".GRN_LED_Pnl;
      JU    GLDN;

GBLK: A     "M 6.5"; // clock-memory bit, same rate as the Calib-lamp blink (see FC155) - real 50/50 square wave, not FB556's ALARM_OUT
      =     "OUTPUTS DB".GRN_LED_Pnl;

GLDN: NOP   0;

NETWORK
TITLE =Red lamp - Blink overrides On/solid, neither = off

      A     "PANEL LED CMD DB".RED_Blink;
      JC    RBLK;

      A     "PANEL LED CMD DB".RED_On;
      =     "OUTPUTS DB".RED_LED_Pnl;
      JU    RLDN;

RBLK: A     "M 6.5"; // clock-memory bit, same rate as the Calib-lamp blink (see FC155) - real 50/50 square wave, not FB556's ALARM_OUT
      =     "OUTPUTS DB".RED_LED_Pnl;

RLDN: NOP   0;

END_FUNCTION
