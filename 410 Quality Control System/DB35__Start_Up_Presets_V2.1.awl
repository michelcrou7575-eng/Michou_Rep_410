DATA_BLOCK "VELOCITY OFFSET TABLE"
TITLE = '410 SEAM - VELOCITY BASE PWM TABLE'
//=====================================================================
// V2.1
//
// PURPOSE
// -------
// Converts actual web velocity into an ABSOLUTE AGC Base PWM value.
//
// The table values are NOT offsets and are NOT signed corrections.
// They are the normal PWM operating values required at each velocity.
//
// FB610 linearly interpolates between adjacent points:
//
//      Actual Velocity
//             |
//             v
//         Base_PWM
//
// The final automatic output is:
//
//      AGC_Out = Base_PWM + AGC_Trim
//
// where AGC_Trim is the signed automatic correction generated by:
//
//      StNone  -> AGC_Trim increases
//      StFlick -> AGC_Trim decreases
//
// When the machine is stopped:
//
//      Velocity = 0 m/min
//      Base_PWM = 50
//      AGC_Trim = 0
//      AGC_Out  = 50
//
// IMPORTANT
// ---------
// 1. Velocity points must remain in ascending order.
// 2. PWM values must remain within 0..255.
// 3. FB610 clamps below Point 1 and above Point 7.
// 4. Lookup_Deadband is the minimum velocity change required before
//    recalculating Active_PWM.
//=====================================================================
VERSION : 2.1


  STRUCT 	//=====================================================================
// VELOCITY
   Point_1_Velocity : INT ;	// DBW0   m/min
   Point_1_Offset : INT  := 70;	// DBW2   absolute Offset
   Point_2_Velocity : INT  := 20;	// DBW4   m/min
   Point_2_Offset : INT  := 60;	// DBW6   absolute Offset
   Point_3_Velocity : INT  := 56;	// DBW8
   Point_3_Offset : INT  := 50;	// DBW10
   Point_4_Velocity : INT  := 92;	// DBW12
   Point_4_Offset : INT  := 40;	// DBW14
   Point_5_Velocity : INT  := 128;	// DBW16
   Point_5_Offset : INT  := 35;	// DBW18
   Point_6_Velocity : INT  := 164;	// DBW20
   Point_6_Offset : INT  := 33;	// DBW22
   Point_7_Velocity : INT  := 200;	// DBW24
   Point_7_Offset : INT  := 31;	// DBW26
//=====================================================================
// L
   Lookup_Deadband : INT  := 1;	// DBW28 m/min
//==================================================================
   Last_Lookup_Velocity : INT ;	// DBW30
   Active_Offset : INT ;	// DBW32 interpolated Base Offset
  END_STRUCT ;	
BEGIN
   Point_1_Velocity := 5; 
   Point_1_Offset := 70; 
   Point_2_Velocity := 20; 
   Point_2_Offset := 60; 
   Point_3_Velocity := 56; 
   Point_3_Offset := 50; 
   Point_4_Velocity := 92; 
   Point_4_Offset := 40; 
   Point_5_Velocity := 128; 
   Point_5_Offset := 35; 
   Point_6_Velocity := 164; 
   Point_6_Offset := 33; 
   Point_7_Velocity := 200; 
   Point_7_Offset := 31; 
   Lookup_Deadband := 1; 
   Last_Lookup_Velocity := 0; 
   Active_Offset := 50; 
END_DATA_BLOCK

