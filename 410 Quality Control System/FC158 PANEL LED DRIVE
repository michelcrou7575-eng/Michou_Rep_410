FUNCTION "SCALE PANEL LAMPS" : VOID
TITLE =Panel LED drive - GRN/RED/WHTx3 command-driven, standalone  FC158
// v0.1 - NEW, per Michou's request (2026-10-05): "a separate 'Panel LED
//   drive' Function ... Controlled by a Byte or Array of bool to: Scan 3
//   WHT LEds FWD/REV, each Independant or Panic Mode (Any ways to
//   impress), And GRN Solid/blink, RED Solid/blink." Drives the 5 lamp
//   bits in "OUTPUTS DB"/DB60 (GRN_LED_Pnl, RED_LED_Pnl, WHT_SWL_1/2/3_
//   Pnl) from the named command bits in "PANEL LED CMD DB"/DB107 - see
//   that file's header for the interface. Timers are FB556/DB108
//   "PANEL_LED_TIMERS_DB", called once per scan below, same proven
//   self-oscillating pattern as FC155's FB555 call.
//
//   White lamp priority (checked in this order, first match wins):
//     1. WHT_Panic   - all 3 lamps strobe together, fast (150ms)
//     2. WHT_ScanFwd/WHT_ScanRev - 1->2->3->1 or 3->2->1->3, 500ms/step
//     3. otherwise   - "independent" direct drive: WHT_1/2/3 mirrored
//        straight to the outputs (this is what Michou called "each
//        Independant")
//   GRN/RED: Blink bit overrides On/solid; neither bit = off.VERSION : 0.1


VAR_TEMP
  SCAN_IN : BOOL ;	
  PANIC_IN : BOOL ;	
  ALARM_IN : BOOL ;	
  SCAN_OUT : BOOL ;	
  PANIC_OUT : BOOL ;	
  ALARM_OUT : BOOL ;	
END_VAR
BEGIN
NETWORK
TITLE =Timers - compute each clock's IN condition, CALL FB556 "PANEL_LE

      A     "PANEL LED CMD DB".WHT_ScanFwd; 
      O     "PANEL LED CMD DB".WHT_ScanRev; 
      AN    "PANEL LED TIMERS DB".SCAN_OUT; 
      =     #SCAN_IN; 

      A     "PANEL LED CMD DB".WHT_Panic; 
      AN    "PANEL LED TIMERS DB".PANIC_OUT; 
      =     #PANIC_IN; 

      A     "PANEL LED CMD DB".GRN_Blink; 
      O     "PANEL LED CMD DB".RED_Blink; 
      AN    "PANEL LED TIMERS DB".ALARM_OUT; 
      =     #ALARM_IN; 


      CALL "PANEL LED TIMERS" , "PANEL LED TIMERS DB" (
           SCAN_IN                  := #SCAN_IN,
           SCAN_IN_TIME             := T#500MS,
           PANIC_IN                 := #PANIC_IN,
           PANIC_IN_TIME            := T#150MS,
           ALARM_IN                 := #ALARM_IN,
           ALARM_IN_TIME            := T#500MS,
           SCAN_OUT                 := #SCAN_OUT,
           PANIC_OUT                := #PANIC_OUT,
           ALARM_OUT                := #ALARM_OUT);

NETWORK
TITLE =White lamp scan step - advances ON each SCAN clock pulse, FWD or

      A     "PANEL LED CMD DB".WHT_ScanFwd; 
      O     "PANEL LED CMD DB".WHT_ScanRev; 
      JCN   WRST; 

      A     "PANEL LED TIMERS DB".SCAN_OUT; 
      JCN   WSDN; 

      A     "PANEL LED CMD DB".WHT_ScanFwd; 
      JCN   WREV; 

      L     "PANEL LED CMD DB".WHT_ScanStep; 
      L     3; 
      >=I   ; 
      JCN   WFIN; 
      L     1; 
      T     "PANEL LED CMD DB".WHT_ScanStep; 
      JU    WSDN; 

WFIN: L     "PANEL LED CMD DB".WHT_ScanStep; 
      L     1; 
      +I    ; 
      T     "PANEL LED CMD DB".WHT_ScanStep; 
      JU    WSDN; 

WREV: L     "PANEL LED CMD DB".WHT_ScanStep; 
      L     1; 
      <=I   ; 
      JCN   WRIN; 
      L     3; 
      T     "PANEL LED CMD DB".WHT_ScanStep; 
      JU    WSDN; 

WRIN: L     "PANEL LED CMD DB".WHT_ScanStep; 
      L     1; 
      -I    ; 
      T     "PANEL LED CMD DB".WHT_ScanStep; 
      JU    WSDN; 

WRST: L     1; 
      T     "PANEL LED CMD DB".WHT_ScanStep; 

WSDN: NOP   0; 

NETWORK
TITLE =White lamps - Panic overrides Scan overrides Independent direct 

      A     "PANEL LED CMD DB".WHT_Panic; 
      JC    WPAN; 

      A     "PANEL LED CMD DB".WHT_ScanFwd; 
      O     "PANEL LED CMD DB".WHT_ScanRev; 
      JC    WSCN; 

      A     "PANEL LED CMD DB".WHT_1; 
      =     "OUTPUTS DB".WHT_SWL_1_Pnl; 
      A     "PANEL LED CMD DB".WHT_2; 
      =     "OUTPUTS DB".WHT_SWL_2_Pnl; 
      A     "PANEL LED CMD DB".WHT_3; 
      =     "OUTPUTS DB".WHT_SWL_3_Pnl; 
      JU    WLDN; 

WPAN: A     "PANEL LED TIMERS DB".PANIC_OUT; 
      =     "OUTPUTS DB".WHT_SWL_1_Pnl; 
      =     "OUTPUTS DB".WHT_SWL_2_Pnl; 
      =     "OUTPUTS DB".WHT_SWL_3_Pnl; 
      JU    WLDN; 

WSCN: L     "PANEL LED CMD DB".WHT_ScanStep; 
      L     1; 
      ==I   ; 
      =     "OUTPUTS DB".WHT_SWL_1_Pnl; 

      L     "PANEL LED CMD DB".WHT_ScanStep; 
      L     2; 
      ==I   ; 
      =     "OUTPUTS DB".WHT_SWL_2_Pnl; 

      L     "PANEL LED CMD DB".WHT_ScanStep; 
      L     3; 
      ==I   ; 
      =     "OUTPUTS DB".WHT_SWL_3_Pnl; 

WLDN: NOP   0; 

NETWORK
TITLE =Green lamp - Blink overrides ON/solid, neither = off

      A     "PANEL LED CMD DB".GRN_Blink; 
      JC    GBLK; 

      A     "PANEL LED CMD DB".GRN_On; 
      =     "OUTPUTS DB".GRN_LED_Pnl; 
      JU    GLDN; 

GBLK: A     "PANEL LED TIMERS DB".ALARM_OUT; 
      =     "OUTPUTS DB".GRN_LED_Pnl; 

GLDN: NOP   0; 

NETWORK
TITLE =Red lamp - Blink overrides ON/solid, neither = off

      A     "PANEL LED CMD DB".RED_Blink; 
      JC    RBLK; 

      A     "PANEL LED CMD DB".RED_On; 
      =     "OUTPUTS DB".RED_LED_Pnl; 
      JU    RLDN; 

RBLK: A     "PANEL LED TIMERS DB".ALARM_OUT; 
      =     "OUTPUTS DB".RED_LED_Pnl; 

RLDN: NOP   0; 

END_FUNCTION

