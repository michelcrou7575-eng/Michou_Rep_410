   Buffer[1].SystemReset := FALSE; 
   Buffer[1].PotMoved := FALSE; 
   Buffer[1].LastBannerEventCount := L#0; 
   Buffer[1].LastEncoderPulse := L#3284009; 
   Buffer[1].EXPWindow := L#0; 
   Buffer[1].RefSum := L#0; 
   Buffer[1].ExpectedNextPulse := L#0; 
   Buffer[1].StateCode := B#16#0; 
