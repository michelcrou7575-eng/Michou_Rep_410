DATA_BLOCK "GLUE SCALE CONTROL DB"    DB105
TITLE =Glue Scale Weight Control and Alarms
// v0.3 changes vs v0.2 - synced against the live online DB (see
//   DB105_Online_1.xps, captured 2026-09-17): these fields were added/
//   renamed directly online, ahead of this source file. Brought back in
//   sync so FC104 compiles against real field names/offsets - see
//   FC104 v0.12 for the corresponding logic changes.
//   - Setpoint_Fill (4.0) -> Fill_Start_SP (4.0) / Fill_Stop_SP (8.0):
//     valve now opens below Fill_Start_SP and closes at/above
//     Fill_Stop_SP directly - the gap between the two IS the hysteresis
//     band now, replacing the old Setpoint_Fill +/- Hysteresis
//     calculation. Hysteresis (still declared below, now at 24.0) is no
//     longer read by FC104's valve network - kept in the struct only
//     because removing it would shift every offset after it; left as an
//     unused/reserved field pending a decision on whether it should
//     still apply on top of the two setpoints.
//   - NEW NegativeUnderScore_Value (20.0): fixed sentinel the KWS CY300
//     sends in the integer-part field when its reading goes negative -
//     confirmed live at 5222222 (all 7 digits of the Byte_0-6 field
//     filled, no leading spaces). Not a real weight - FC104 now compares
//     GrossWeight_Actual against this every scan to catch a scale fault.
//   - NEW SpareReal (28.0): appeared online, not yet wired to anything.
//   - Address 32.5 (Scale_Powered_On) appeared online - carried over
//     as-is, not wired by FC104 yet, no confirmed intended behavior.
//   - Address 32.6 (was a plain spare bit online) repurposed here as
//     Alarm_ScaleFault - latching output, set when GrossWeight_Actual
//     matches NegativeUnderScore_Value (see FC104).
//   - Initial values below are set to match the live/tuned Actual
//     values captured in DB105_Online_1.xps (Fill_Start_SP=50,
//     Fill_Stop_SP=70, AlarmLimit_Overfill=80, AlarmLimit_Underfill=20,
//     Hysteresis=2, NegativeUnderScore_Value=5222222) rather than the
//     all-zero initial values the online capture showed for every
//     field - a cold download of this source would otherwise silently
//     wipe the operator's live tuning back to zero.
//
// v0.4 changes vs v0.3:
//   - Address 32.7 (was SpareBool_2) repurposed as Reset_Alarms - a
//     single HMI-driven command bit that clears all three latching
//     alarms (Overfill, Underfill, ScaleFault) at once. FC104's new
//     reset network reads this bit directly (level-conditioned, not
//     edge-detected) - FC104 is a FUNCTION with no static memory of its
//     own to hold edge-detect state in, and a plain level read is
//     sufficient for a momentary HMI acknowledge button: R only forces
//     the alarms to 0 while this bit is TRUE, and each alarm's own
//     latch network is free to re-set it the very next scan if the
//     underlying fault is still present - it cannot be permanently
//     masked by holding the button down.
//
// v0.5 changes vs v0.4 - canonicalize on FC155 (per Michou's call):
//   the live PLC project compiled this DB's owning FUNCTION as FC104,
//   then renumbered it FC155 "GLUE SCALE LOGIC" and renamed this DB's
//   own symbol from "GLUE_SCALE_CONTROL_DB" to "GLUE SCALE CONTROL DB"
//   (spaces, matching FC155's actual CALL/read references - confirmed
//   by diffing FC155's STEP7 export against FC104_GLUE_SCALE.awl v0.13:
//   logic is byte-for-byte identical, only the block number and symbol
//   names differ). FC104_GLUE_SCALE.awl is deleted from this repo -
//   FC155 is now the sole tracked source for this logic. Only this
//   DATA_BLOCK header line changed (symbol name); every field, offset,
//   and initial value below is unchanged from v0.4.
//
// v0.6 changes vs v0.5 - REAL -> INT for the scale weight/setpoints
//   (per Michou's call - the scale transaction doesn't need fractional
//   precision; every live setpoint was already a whole number anyway:
//   Fill_Start_SP=50, Fill_Stop_SP=70, AlarmLimit_Overfill=80,
//   AlarmLimit_Underfill=20, Hysteresis=2). GrossWeight_Actual,
//   Fill_Start_SP, Fill_Stop_SP, AlarmLimit_Overfill,
//   AlarmLimit_Underfill and Hysteresis are now INT - see FC155 v0.14
//   for the corresponding parse/compare changes (Byte_8's decimal digit
//   is now discarded, not converted).
//   NegativeUnderScore_Value is the one exception - stays DINT (was
//   REAL, NOT changed to plain INT): the sentinel value is 5222222,
//   which does not fit in 16-bit INT range (+/-32767) - a plain INT
//   would silently wrap it and the fault comparison would never match
//   again. FC155 now compares the wide #IntPart temp against this DINT
//   BEFORE truncating it into the INT GrossWeight_Actual - see that
//   block's changelog.
//   SpareReal is untouched (REAL) - it isn't part of the scale
//   transaction, no reason to touch its type here.
//   Initial values below carry the same live-tuned numbers forward in
//   their new INT/DINT representation - no setpoint value changed.
VERSION : 0.6

  STRUCT
   GrossWeight_Actual : INT ;	//Parsed live weight from KWS CY300 scale (kg) - whole kg, scale's decimal digit is discarded (see FC155)
   Fill_Start_SP : INT ;	//Operator-entered fill-start weight (kg) - valve opens below this - HMI writable
   Fill_Stop_SP : INT ;	//Operator-entered fill-stop weight (kg) - valve closes at/above this - HMI writable
   AlarmLimit_Overfill : INT ;	//Operator-entered max allowed weight (kg) - HMI writable
   AlarmLimit_Underfill : INT ;	//Operator-entered min allowed weight (kg) - HMI writable
   NegativeUnderScore_Value : DINT ;	//Fixed sentinel value the KWS CY300 sends when its reading is negative (scale fault) - DINT, not INT: 5222222 doesn't fit in 16 bits - see FC155
   Hysteresis : INT ;	//Reserved - no longer read by FC155's valve network (see v0.3 changelog); kept for struct-layout compatibility
   SpareReal : REAL ;
   Valve_Open : BOOL ;	//Output: TRUE = valve open, filling in progress
   Alarm_Overfill : BOOL ;	//Output: TRUE = weight exceeded overfill limit (latching)
   Alarm_Underfill : BOOL ;	//Output: TRUE = weight below underfill limit at settle check (latching)
   ParseError : BOOL ;	//Output: TRUE = ASCII parse failed this scan (bad/garbled scale data)
   Valve_Open_Prev : BOOL ;	//Internal: previous scan Valve_Open state, for edge detection
   Scale_Powered_On : BOOL ;	//Live Data Coming In - not yet wired by FC155
   Alarm_ScaleFault : BOOL ;	//Output: TRUE = the scale's raw parsed integer matched NegativeUnderScore_Value this scan - scale reporting a negative/fault reading (latching)
   Reset_Alarms : BOOL ;	//Input: HMI-driven, hold/pulse TRUE to clear Alarm_Overfill, Alarm_Underfill and Alarm_ScaleFault
  END_STRUCT ;
BEGIN
   GrossWeight_Actual := 0;
   Fill_Start_SP := 50;
   Fill_Stop_SP := 70;
   AlarmLimit_Overfill := 80;
   AlarmLimit_Underfill := 20;
   NegativeUnderScore_Value := L#5222222;
   Hysteresis := 2;
   SpareReal := 0.0;
   Valve_Open := FALSE;
   Alarm_Overfill := FALSE;
   Alarm_Underfill := FALSE;
   ParseError := FALSE;
   Valve_Open_Prev := FALSE;
   Scale_Powered_On := FALSE;
   Alarm_ScaleFault := FALSE;
   Reset_Alarms := FALSE;
END_DATA_BLOCK
