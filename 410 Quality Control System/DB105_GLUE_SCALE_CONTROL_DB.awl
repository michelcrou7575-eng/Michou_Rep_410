DATA_BLOCK "GLUE SCALE CONTROL DB"
TITLE =Glue Scale Weight Control and Alarms  DB105
// History (full blow-by-blow in git log, this comment block was
// trimmed 2026-10-02 after FC155's own header grew past STEP7's
// title/comment size limit and failed to compile - "Byte offset/number
// too big". This DB's header was getting close too. Keep future
// entries short.):
//
// v0.3-v0.7: synced field names/offsets/types against repeated live
//   online edits (Setpoint_Fill->Fill_Start_SP/Fill_Stop_SP,
//   NegativeUnderScore_Value sentinel added, Reset_Alarms added,
//   REAL->INT conversion, SpareReal1-3 appeared online).
// v0.8-v0.9: reconciled against Michou's parallel online FC155 rebuild
//   (AlarmLimit_*_SP naming, GrossWeight_Actual_Mem snapshot,
//   Valve_Open->Pump_ON rename); added LampScanClockMem/LampScanStep
//   for the white-lamp scan pattern; Overfill/Underfill now interlock
//   Pump_ON.
// v0.10-v0.12: added PlatformMinWeight_SP (empty-platform ~30kg sanity
//   check, same alarm bit as the scale-fault sentinel); added then
//   confirmed NegativeUnderScore_Value is INT -20663 (not DINT
//   5222222 as first assumed - Michou: "no more DINT/5222222!").
// v0.13-v0.14: ReCalib_Step now powers the scale off first (0-5, not
//   0-4); Michou refactored this struct directly online - removed
//   PowerOff_Step/ReCalib_ReqMem/PowerOff_ReqMem, replaced the
//   standalone power-off trigger with Scale_PowerOFF_Pulse, added
//   Scale_PowerON_Pulse (new standalone power-on trigger),
//   PlatformMinWeight_SP moved + gained an inline default, SpareReal1
//   dropped (SpareReal2 remains) + NEW Spare_INT, GrossWeight_Actual's
//   initial value is -20663 (deliberate test-state default).
// v0.16 - comment-only: ReCalib_Step's field comment still described
//   FC156's original (and already-superseded) 4-step sequence. Updated
//   to match FC155 v0.28's corrected "Process ON" sequence (K1+K2
//   simultaneous, 5s K2-alone power-off, 3s dwell wait) - see that
//   file's own changelog for the full reasoning. No struct/field
//   changes.
// v0.17 - comment-only: FC155 v0.29 no longer writes LampScanStep/
//   LampScanClockMem (white-lamp driving moved to the new FC157 "PANEL
//   LED DRIVE" / "PANEL LED CMD DB" - see those files). Fields left
//   declared (not deleted - may still be HMI-wired) but marked
//   superseded/dead below.
// v0.18 - per Michou (2026-10-06): "Need a 30 sec delay before
//   restarting after power has resumed ... Need to restart KiloTech
//   Scale too and make sure it is calibrated before operating the
//   pump!" Added PowerUp_Settled (internal one-shot latch FC155 uses to
//   feed FB555's new 30s startup-stabilization timer - reset FALSE by
//   OB100 every restart) and Scale_Calibrated (TRUE once a
//   recalibration has completed since the last restart - reset FALSE
//   by OB100, SET by FC155's RCS5 - interlocks the pump). See FC155
//   v0.30 and OB100_COMPLETE_RESTART.awl's own changelog.
// v0.19 - comment-only: two field comments below still pointed at
//   FC157/DB108, both superseded (FC157 -> FC158, DB108 -> DB556 -
//   see those files' own changelogs). Updated to match.
VERSION : 0.19

 STRUCT
   GrossWeight_Actual : INT ;	//Parsed live weight from KWS CY300 scale (kg) - whole kg, scale's decimal digit 
   GrossWeight_Actual_Mem : INT ;	//Snapshot of GrossWeight_Actual taken on the scan the pump Started
   Fill_Start_SP : INT ;	//Operator-entered fill-start weight (kg) - pump turns on below this - HMI writab
   Fill_Stop_SP : INT ;	//Operator-entered fill-stop weight (kg) - pump turns off at/above this - HMI wri
   AlarmLimit_Overfill_SP : INT ;	//Operator-entered max allowed weight (kg) - HMI writable - latching, interlocks 
   AlarmLimit_Underfill_SP : INT ;	//Operator-entered min allowed weight (kg) - HMI writable - latching, interlocks 
   Actual_Transfered_Weight : INT ;	//Actual Glue Transfered Weight [Kg] since last started - GrossWeight_Ac
   NegativeUnderScore_Value : INT ;	//Fixed sentinel value the KWS CY300 sends when its reading is negative (scale fa
   Hysteresis : INT ;	//Reserved - no longer read by FC155's pump-control network (see v0.3 changelog);
   LampScanStep : INT ;	//DEAD as of FC155 v0.29 - superseded by "PANEL LED CMD DB".WHT_ScanStep, see FC158
   ReCalib_Step : INT ;	//FC155 sequence step - 0 idle, 1 K2-alone 5s power-off, 2 3s dwell wait, 3 Process ON (K1+K2 start together), 4 waiting for K1's 5s hold, 5 K1 off/done
   PlatformMinWeight_SP : INT  := 30;	//Scale Platform Min Weight SP 30 [Kg]
   Spare_INT : INT ;	
   SpareReal2 : REAL ;	
   Pump_ON : BOOL ;	//Output: TRUE = glue fill pump commanded on, filling in progress - mirrored onto
   Alarm_Overfill : BOOL ;	//Output: TRUE = weight exceeded overfill limit (latching) - interlocks Pump_ON o
   Alarm_Underfill : BOOL ;	//Output: TRUE = weight below underfill limit at settle check (latching) - interl
   ParseError : BOOL ;	//Output: TRUE = ASCII parse failed this scan (bad/garbled scale data)
   Pump_ON_Prev : BOOL ;	//Internal: previous scan Pump_ON state, for edge detection (was Valve_Open_Prev)
   Scale_Powered_On : BOOL ;	//Live Data Coming In - Status
   Alarm_ScaleFault : BOOL ;	//Output: TRUE = the scale's raw parsed integer matched NegativeUnderScore_Value 
   Reset_Alarms : BOOL ;	//Input: HMI-driven, hold/pulse TRUE to clear Alarm_Overfill, Alarm_Underfill and
   LampScanClockMem : BOOL ;	//DEAD as of FC155 v0.29 - superseded by FB556/DB556's own clock, see FC158
   Scale_PowerOFF_Pulse : BOOL ;	//Scale Power-Off Process (Power Hold 3s)
   Scale_ReCalib_Req : BOOL ;	//Start the Power-Off calibration sequence (Power Hold 3s)
   Scale_PowerON_Pulse : BOOL ;	//Input: HMI/manual, pulse or hold TRUE to run "Process ON" standalone (K1+K2 together, see ReCalib_Step/FC155) - enters the same ReCalib_Step sequence directly at step 3, auto-clears when done
   Spare_11 : BOOL ;
   Spare_12 : BOOL ;
   Spare_13 : BOOL ;
   Spare_14 : BOOL ;
   Spare_15 : BOOL ;
   PowerUp_Settled : BOOL ;	//Internal - one-shot latch, FALSE for exactly one scan after OB100 resets it, then TRUE forever until the next restart - feeds FB555's STARTUP_IN so its 30s timer starts fresh every power-up
   Scale_Calibrated : BOOL ;	//Output: TRUE once the scale has completed a recalibration since the last restart - reset FALSE by OB100, SET by FC155 on ReCalib_Step completion (RCS5) - interlocks the pump
  END_STRUCT ;
BEGIN
   GrossWeight_Actual := -20663; 
   GrossWeight_Actual_Mem := 0; 
   Fill_Start_SP := 50; 
   Fill_Stop_SP := 70; 
   AlarmLimit_Overfill_SP := 80; 
   AlarmLimit_Underfill_SP := 20; 
   Actual_Transfered_Weight := 0; 
   NegativeUnderScore_Value := -20663; 
   Hysteresis := 2; 
   LampScanStep := 1; 
   ReCalib_Step := 0; 
   PlatformMinWeight_SP := 30; 
   Spare_INT := 0; 
   SpareReal2 := 0.000000e+000; 
   Pump_ON := FALSE; 
   Alarm_Overfill := FALSE; 
   Alarm_Underfill := FALSE; 
   ParseError := FALSE; 
   Pump_ON_Prev := FALSE; 
   Scale_Powered_On := FALSE; 
   Alarm_ScaleFault := FALSE; 
   Reset_Alarms := FALSE; 
   LampScanClockMem := FALSE; 
   Scale_PowerOFF_Pulse := FALSE; 
   Scale_ReCalib_Req := FALSE; 
   Scale_PowerON_Pulse := FALSE; 
   Spare_11 := FALSE; 
   Spare_12 := FALSE; 
   Spare_13 := FALSE; 
   Spare_14 := FALSE;
   Spare_15 := FALSE;
   PowerUp_Settled := FALSE;
   Scale_Calibrated := FALSE;
END_DATA_BLOCK
